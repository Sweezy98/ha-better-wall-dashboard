# Copy to .env and fill in. .env is not committed.
#
# The Home Assistant the dev server talks to. Must be https for `npm run sync`.
VITE_HA_URL=https://homeassistant.local:8123
# SSH access for `npm run deploy`, which copies the whole integration into
# /config/custom_components and reloads it. See
# https://shannonhochkins.github.io/ha-component-kit/?path=/docs/introduction-deploying--docs#retrieving-ssh-credentials
VITE_SSH_USERNAME=
VITE_SSH_PASSWORD=
VITE_SSH_HOSTNAME=
